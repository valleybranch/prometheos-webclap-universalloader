+ */
+
+#include "boxedwine.h"
+
+#ifdef __TEST
+
+#include "testVstBridge.h"
+#include "devvstbridge.h"
+#include "../../kernel/devs/vstbridge_abi.h"
+#include "../cpu/testCPU.h"
+#include "kstat.h"
+
+#include <cstring>
+#include <filesystem>
+#include <thread>
+#include <vector>
+
+// The host side of /dev/vstbridge is JavaScript in the browser; here the test
+// plays it, writing the region directly, while the device is driven through
+// readNative/writeNative as the guest's read()/write() would.
+namespace {
+
+constexpr U32 kBlock = 256;
+constexpr U32 kChannel = 3;
+
+U8* region() { return vstbridgeRegion(); }
+vstb_ctrl_header* ctrl() { return reinterpret_cast<vstb_ctrl_header*>(region() + VSTB_CTRL_OFFSET); }
+U8* channelBase(U32 channel) { return region() + VSTB_CHANNELS_OFFSET + (channel - 1) * VSTB_CHANNEL_BYTES; }
+vstb_channel_ctl* ctl(U32 channel) { return reinterpret_cast<vstb_channel_ctl*>(channelBase(channel)); }
+float* ring(U32 channel, U32 offset, U32 index) {
+    return reinterpret_cast<float*>(channelBase(channel) + offset) + index * VSTB_RING_FRAMES;
+}
+S32 load(S32* p) { return __atomic_load_n(p, __ATOMIC_SEQ_CST); }
+
+void expectU32(const char* label, U32 actual, U32 expected) {
+    if (actual != expected) {
+        testFail("%s expected %u, got %u", label, expected, actual);
+    }
+}
+
+void expectFloat(const char* label, float actual, float expected) {
+    if (actual != expected) {
+        testFail("%s expected %f, got %f", label, (double)expected, (double)actual);
+    }
+}
+
+// Host: publishes block k with one note event and input samples k * 1000 + frame.
+void publish(U32 k) {
+    U8* slot = channelBase(kChannel) + VSTB_SLOTS_OFFSET + (k % VSTB_SLOTS) * VSTB_REQUEST_BYTES;
+    memset(slot, 0, VSTB_REQUEST_BYTES);
+    vstb_request* r = reinterpret_cast<vstb_request*>(slot);
+    r->blockIndex = k;
+    r->frames = kBlock;
+    r->eventCount = 1;
+    r->events[0].offset = k % kBlock;
+    r->events[0].type = VSTB_EV_MIDI;
+    r->events[0].midi[0] = 0x90;
+    r->events[0].midi[1] = (U8)(k & 0x7f);
+    const U32 frame = (k * kBlock) % VSTB_RING_FRAMES;
+    for (U32 c = 0; c < 2; c++) {
+        for (U32 f = 0; f < kBlock; f++) {
+            ring(kChannel, VSTB_IN_RINGS_OFFSET, c)[frame + f] = (float)(k * 1000 + f) * (c ? -1.0f : 1.0f);
+        }
+    }
+    __atomic_store_n(&ctl(kChannel)->requestSeq, (S32)(k + 1), __ATOMIC_SEQ_CST);
+    __atomic_add_fetch(&ctl(kChannel)->doorbell, 1, __ATOMIC_SEQ_CST);
+}
+
+// Guest: reads one record, as vsthost does (exact size).
+U32 readRecord(FsOpenNode* node, std::vector<U8>& buffer, U32 bytes) {
+    buffer.assign(bytes, 0);
+    U32 total = 0;
+    while (total < bytes) {
+        U32 n = node->readNative(buffer.data() + total, bytes - total);
+        if ((S32)n <= 0) {
+            break;
+        }
+        total += n;
+    }
+    return total;
+}
+
+// Guest: answers block k with output samples -(k * 1000 + frame), written in two pieces.
+void respond(FsOpenNode* node, U32 k, U32 split) {
+    std::vector<U8> out(VSTB_RESPONSE_HEADER_BYTES + 2 * kBlock * sizeof(float));
+    vstb_response* r = reinterpret_cast<vstb_response*>(out.data());
+    r->blockIndex = k;
+    r->frames = kBlock;
+    r->processUs = 100 + k;
+    float* audio = reinterpret_cast<float*>(out.data() + VSTB_RESPONSE_HEADER_BYTES);
+    for (U32 c = 0; c < 2; c++) {
+        for (U32 f = 0; f < kBlock; f++) {
+            audio[c * kBlock + f] = -(float)(k * 1000 + f) + (float)c;
+        }
+    }
+    const S32 before = load(&ctl(kChannel)->responseSeq);
+    expectU32("first piece accepted", node->writeNative(out.data(), split), split);
+    expectU32("no response before the record is complete", load(&ctl(kChannel)->responseSeq), before);
+    expectU32("second piece accepted", node->writeNative(out.data() + split, (U32)out.size() - split),
+        (U32)out.size() - split);
+}
+
+FsOpenNode* openDevice(const std::shared_ptr<FsNode>& node) {
+    FsOpenNode* open = node->open(K_O_RDWR);
+    if (!open) {
+        testFail("could not open the vstbridge test node");
+    }
+    return open;
+}
+
+void attach(FsOpenNode* node, U32 channel) {
+    vstb_attach a = {};
+    a.magic = VSTB_ATTACH_MAGIC;
+    a.channel = channel;
+    a.sampleRate = 48000;
+    a.blockFrames = kBlock;
+    a.inPorts = 1;
+    a.outPorts = 1;
+    a.pluginLatency = 7;
+    expectU32("attach accepted", node->writeNative(reinterpret_cast<U8*>(&a), sizeof a), sizeof a);
+}
+
+} // namespace
+
+void testVstBridge() {
+    const BString root = B("tmp/test-vstbridge-root");
+    std::error_code error;
+    std::filesystem::create_directories(root.c_str(), error);
+    Fs::initFileSystem(root);
+    std::shared_ptr<FsNode> rootNode = Fs::getNodeFromLocalPath(B(""), B("/"), true);
+    std::shared_ptr<FsNode> node = Fs::addVirtualFile(B("/vstbridge"), openDevVstBridge,
+        K__S_IREAD | K__S_IWRITE | K__S_IFCHR, k_mdev(10, 240), rootNode);
+
+    const vstb_region_header* h = reinterpret_cast<const vstb_region_header*>(region());
+    expectU32("region magic", h->magic, VSTB_MAGIC);
+    expectU32("region size", h->regionBytes, VSTB_REGION_BYTES);
+
+    // An unattached handle refuses reads.
+    FsOpenNode* audio = openDevice(node);
+    U8 byte = 0;
+    expectU32("read before attach", audio->readNative(&byte, 1), (U32)-K_EINVAL);
+
+    const S32 generation = load(&ctl(kChannel)->generation);
+    attach(audio, kChannel);
+    expectU32("state ready", load(&ctl(kChannel)->state), VSTB_STATE_READY);
+    expectU32("generation bumped", load(&ctl(kChannel)->generation), generation + 1);
+    expectU32("block frames", load(&ctl(kChannel)->blockFrames), kBlock);
+    expectU32("plugin latency", load(&ctl(kChannel)->pluginLatency), 7);
+    expectU32("sequences restart", load(&ctl(kChannel)->requestSeq), 0);
+
+    // In order, across the ring wrap (8192 / 256 = 32 blocks), one block ahead.
+    const U32 recordBytes = VSTB_REQUEST_BYTES + 2 * kBlock * sizeof(float);
+    std::vector<U8> buffer;
+    publish(0);
+    for (U32 k = 0; k < 100; k++) {
+        publish(k + 1);
+        expectU32("record size", readRecord(audio, buffer, recordBytes), recordBytes);
+        const vstb_request* r = reinterpret_cast<const vstb_request*>(buffer.data());
+        expectU32("block index", r->blockIndex, k);
+        expectU32("event note", r->events[0].midi[1], k & 0x7f);
+        const float* in = reinterpret_cast<const float*>(buffer.data() + VSTB_REQUEST_BYTES);
+        expectFloat("input L", in[17], (float)(k * 1000 + 17));
+        expectFloat("input R", in[kBlock + 17], -(float)(k * 1000 + 17));
+        respond(audio, k, 1 + (k * 37) % (VSTB_RESPONSE_HEADER_BYTES + 2 * kBlock * 4 - 1));
+        expectU32("response seq", load(&ctl(kChannel)->responseSeq), k + 1);
+        const U32 frame = (k * kBlock) % VSTB_RING_FRAMES;
+        expectFloat("output L in ring", ring(kChannel, VSTB_OUT_RINGS_OFFSET, 0)[frame + 5], -(float)(k * 1000 + 5));
+        expectFloat("output R in ring", ring(kChannel, VSTB_OUT_RINGS_OFFSET, 1)[frame + 5], -(float)(k * 1000 + 5) + 1);
+        expectU32("guest process time", load(&ctl(kChannel)->lastProcessUs), 100 + k);
+        expectU32("done stamp", load(&ctl(kChannel)->doneBlock[k % VSTB_SLOTS]), k + 1);
+    }
+    // Block 100 was published above and is read next.
+    expectU32("pending block 100", readRecord(audio, buffer, recordBytes), recordBytes);
+    expectU32("block 100", reinterpret_cast<const vstb_request*>(buffer.data())->blockIndex, 100);
+
+#ifndef BOXEDWINE_MULTI_THREADED
+    // Nothing pending: the single-threaded build returns no data instead of blocking.
+    expectU32("no request pending", audio->readNative(buffer.data(), recordBytes), 0);
+#endif
+
+    // The host runs 40 blocks ahead: more than the ring holds (window 31), so the
+    // device skips to the oldest block whose slot and inputs are intact.
+    for (U32 k = 101; k < 141; k++) {
+        publish(k);
+    }
+    expectU32("skipped record", readRecord(audio, buffer, recordBytes), recordBytes);
+    expectU32("oldest safe block", reinterpret_cast<const vstb_request*>(buffer.data())->blockIndex, 141 - 31);
+    expectU32("skip count", load(&ctl(kChannel)->skipped), 141 - 31 - 101);
+    expectFloat("skipped block's input", reinterpret_cast<const float*>(buffer.data() + VSTB_REQUEST_BYTES)[3],
+        (float)(110 * 1000 + 3));
+    for (U32 k = 111; k < 141; k++) {
+        readRecord(audio, buffer, recordBytes);
+    }
+
+    // Control channel: a request is read as header then payload, and a KICK
+    // written there makes the audio channel's next read a kick record.
+    FsOpenNode* control = openDevice(node);
+    attach(control, 0);
+    expectU32("bridge serving", h->bridgeState, VSTB_BRIDGE_SERVING);
+    vstb_msg* request = reinterpret_cast<vstb_msg*>(region() + VSTB_CTRL_REQUEST_OFFSET);
+    const S32 seq = load(&ctrl()->requestSeq) + 1;
+    request->seq = (U32)seq;
+    request->op = VSTB_OP_PING;
+    request->length = 5;
+    memcpy(region() + VSTB_CTRL_REQUEST_OFFSET + sizeof(vstb_msg), "hello", 5);
+    __atomic_store_n(&ctrl()->requestSeq, seq, __ATOMIC_SEQ_CST);
+    expectU32("control header", readRecord(control, buffer, sizeof(vstb_msg)), sizeof(vstb_msg));
+    expectU32("control op", reinterpret_cast<const vstb_msg*>(buffer.data())->op, VSTB_OP_PING);
+    expectU32("control payload", readRecord(control, buffer, 5), 5);
+    expectU32("payload bytes", memcmp(buffer.data(), "hello", 5), 0);
+
+    std::vector<U8> reply(sizeof(vstb_msg) + 4);
+    vstb_msg* msg = reinterpret_cast<vstb_msg*>(reply.data());
+    msg->seq = (U32)seq;
+    msg->op = VSTB_OP_PING;
+    msg->length = 4;
+    memcpy(reply.data() + sizeof(vstb_msg), "pong", 4);
+    control->writeNative(reply.data(), (U32)reply.size());
+    expectU32("control response seq", load(&ctrl()->responseSeq), seq);
+    expectU32("control response", memcmp(region() + VSTB_CTRL_RESPONSE_OFFSET + sizeof(vstb_msg), "pong", 4), 0);
+
+    vstb_msg kick = {};
+    kick.op = VSTB_OP_KICK;
+    kick.channel = kChannel;
+    control->writeNative(reinterpret_cast<U8*>(&kick), sizeof kick);
+    expectU32("kick record is short", readRecord(audio, buffer, recordBytes), VSTB_REQUEST_BYTES);
+    expectU32("kick flag", reinterpret_cast<const vstb_request*>(buffer.data())->flags, VSTB_REQ_KICK);
+
+#ifdef BOXEDWINE_MULTI_THREADED
+    // A blocked read wakes when the host publishes from another thread.
+    std::thread host([] {
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        publish(141);
+    });
+    expectU32("blocking read", readRecord(audio, buffer, recordBytes), recordBytes);
+    expectU32("woken block", reinterpret_cast<const vstb_request*>(buffer.data())->blockIndex, 141);
+    host.join();
+#endif
+
+    delete control;
+    delete audio;
+    expectU32("closed", load(&ctl(kChannel)->state), VSTB_STATE_CLOSED);
+    expectU32("bridge stopped", h->bridgeState, VSTB_BRIDGE_NONE);
+    KSystem::setProcNode(nullptr);
+    Fs::shutDown();
+    Fs::deleteNativeDirAndAllFilesInDir(root);
+}
+
+#endif
