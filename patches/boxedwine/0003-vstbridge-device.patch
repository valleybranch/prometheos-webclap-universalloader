+#ifndef __DEVVSTBRIDGE_H__
+#define __DEVVSTBRIDGE_H__
+
+// /dev/vstbridge: shared-memory audio channels for a guest plugin host
+// (source/kernel/devs/devvstbridge.cpp, layout in vstbridge_abi.h).
+FsOpenNode* openDevVstBridge(const std::shared_ptr<FsNode>& node, U32 flags, U32 data);
+
+// The shared region (VSTB_REGION_BYTES). The page reads its address through the
+// exported vstbridge_region().
+U8* vstbridgeRegion();
+
+#endif
